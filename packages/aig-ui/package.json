{
  "name": "aig-ui",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/button/button.d.ts",
      "import": "./dist/components/button/button.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "import": "./dist/motion/index.js"
    },
    "./motion/styles.css": "./dist/motion/styles.css",
    "./icon-button": {
      "types": "./dist/components/icon-button/icon-button.d.ts",
      "import": "./dist/components/icon-button/icon-button.js"
    },
    "./link": {
      "types": "./dist/components/link/link.d.ts",
      "import": "./dist/components/link/link.js"
    },
    "./text": {
      "types": "./dist/components/text/text.d.ts",
      "import": "./dist/components/text/text.js"
    },
    "./heading": {
      "types": "./dist/components/heading/heading.d.ts",
      "import": "./dist/components/heading/heading.js"
    },
    "./icon": {
      "types": "./dist/components/icon/icon.d.ts",
      "import": "./dist/components/icon/icon.js"
    },
    "./card": {
      "types": "./dist/components/card/card.d.ts",
      "import": "./dist/components/card/card.js"
    },
    "./panel": {
      "types": "./dist/components/panel/panel.d.ts",
      "import": "./dist/components/panel/panel.js"
    },
    "./badge": {
      "types": "./dist/components/badge/badge.d.ts",
      "import": "./dist/components/badge/badge.js"
    },
    "./spinner": {
      "types": "./dist/components/spinner/spinner.d.ts",
      "import": "./dist/components/spinner/spinner.js"
    }
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "lucide-react": "1.45.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  }
}
