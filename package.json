{
  "name": "aig-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "tokens": "node scripts/tokens.mjs && node scripts/icons.mjs",
    "typecheck": "pnpm tokens && tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm tokens && tsc -p packages/aig-ui/tsconfig.json && node scripts/build.mjs && node scripts/metadata.mjs && node scripts/registry.mjs",
    "dev": "storybook dev -p 6006 -c apps/docs/.storybook --no-open",
    "build:docs": "storybook build -c apps/docs/.storybook -o artifacts/storybook",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "preview": "pnpm --dir apps/preview dev",
    "build:preview": "pnpm --dir apps/preview build",
    "test:browser": "playwright test",
    "test:motion": "playwright test tests/browser/motion.spec.ts",
    "lint": "eslint .",
    "format": "prettier --write packages apps registry scripts tests examples *.ts *.mjs",
    "format:check": "prettier --check packages apps registry scripts tests examples *.ts *.mjs",
    "build:registry": "node scripts/registry.mjs",
    "check:artifacts": "node scripts/metadata.mjs && node scripts/registry.mjs",
    "prepare:consumer": "node scripts/consumer-source.mjs",
    "pack:local": "pnpm --dir packages/aig-ui pack --pack-destination ../../artifacts",
    "check:size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "aig-ui": "workspace:*",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
