{
  "name": "aig-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "typecheck": "pnpm tokens && tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm tokens && tsc -p packages/aig-ui/tsconfig.json && node scripts/build.mjs",
    "dev": "storybook dev -p 6006 -c apps/docs/.storybook --no-open",
    "build:docs": "storybook build -c apps/docs/.storybook -o artifacts/storybook",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "preview": "pnpm --dir apps/preview dev",
    "build:preview": "pnpm --dir apps/preview build",
    "test:browser": "playwright test",
    "test:motion": "playwright test tests/browser/motion.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
